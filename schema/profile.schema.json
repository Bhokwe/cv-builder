{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cv-builder.local/schema/profile.schema.json",
  "title": "MasterProfile",
  "description": "Verified master store of a person's career experience (roles, achievements, skills, metrics).",
  "type": "object",
  "required": ["schemaVersion", "profileId", "roles", "skills"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/definitions/Role" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/definitions/Skill" }
    }
  },
  "definitions": {
    "Role": {
      "type": "object",
      "required": ["id", "title", "organization", "startDate", "endDate", "achievements"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "endDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "achievements": {
          "type": "array",
          "items": { "$ref": "#/definitions/Achievement" }
        }
      }
    },
    "Achievement": {
      "type": "object",
      "required": ["id", "bulletPoint", "metrics"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bulletPoint": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/definitions/Metric" }
        }
      }
    },
    "Metric": {
      "type": "object",
      "required": ["id", "label", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "Skill": {
      "type": "object",
      "required": ["id", "name", "category"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 }
      }
    }
  }
}
